APP_NAME="SI-Logistik SMA Taruna Nusantara IKN"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Makassar

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=si_logistik
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@logistik.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- SI-LOGISTIK ---
LOGISTIK_NAMA_APLIKASI="SI-Logistik SMA Taruna Nusantara IKN"
LOGISTIK_NAMA_SINGKAT="SI-Logistik"
LOGISTIK_NAMA_INSTANSI="SMA Taruna Nusantara IKN"
LOGISTIK_KATA_KUNCI_PEMULIHAN=

# Akun admin awal (dipakai AdminSeeder). Kosongkan ADMIN_PASSWORD agar dibuat acak.
ADMIN_NAME="Admin Logistik"
ADMIN_EMAIL=admin@logistik.local
ADMIN_PASSWORD=
